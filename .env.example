# Vision AI API key — use any OpenAI-compatible provider with vision support
# Recommended: OpenAI (platform.openai.com) — gpt-4o-mini, cheap and accurate
# Alternative: Anthropic (console.anthropic.com) — requires code change to use anthropic SDK
ANTHROPIC_API_KEY=sk-your_openai_key_here

POSTGRES_DB=stalvia
POSTGRES_USER=stalvia
POSTGRES_PASSWORD=canvia_aquest_password
DATABASE_URL=postgresql://stalvia:canvia_aquest_password@postgres:5432/stalvia
REDIS_URL=redis://redis:6379
