# Providers: openai, anthropic, openai_compatible
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Required only for openai_compatible, e.g. https://provider.example/v1
AI_BASE_URL=
# Leave empty for automatic defaults (true for OpenAI, false otherwise).
AI_JSON_MODE=
AI_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=6000
# Existing OPENAI_API_KEY / OPENAI_MODEL remain supported for OpenAI.
# ANTHROPIC_API_KEY is supported only when AI_PROVIDER=anthropic.
POSTGRES_DB=stalvia
POSTGRES_USER=stalvia
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# DATABASE_URL is optional: the backend constructs it from POSTGRES_* safely.
REDIS_URL=redis://redis:6379
SCRAPER_CONCURRENCY=2
MERCADONA_POSTAL_CODE=08759
# Bind to the host LAN address only when an external proxy needs access.
BIND_ADDRESS=127.0.0.1
# Same-origin requests need no CORS configuration.
CORS_ORIGINS=
