OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
POSTGRES_DB=stalvia
POSTGRES_USER=stalvia
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
# DATABASE_URL is optional: the backend constructs it from POSTGRES_* safely.
REDIS_URL=redis://redis:6379
SCRAPER_CONCURRENCY=2
MERCADONA_WAREHOUSE=vlc1
# Bind to the host LAN address only when an external proxy needs access.
BIND_ADDRESS=127.0.0.1
# Same-origin requests need no CORS configuration.
CORS_ORIGINS=
